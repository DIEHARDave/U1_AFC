+    def _u1_xy_only_homed(self) -> bool:
+        """
+        U1_AFC: True when X and Y are homed but Z is not (the U1 print start state
+        after "G28 X Y").
+        """
+        try:
+            homed = self.toolhead.get_status(self.reactor.monotonic())['homed_axes']
+        except Exception:
+            return False
+        return 'x' in homed and 'y' in homed and 'z' not in homed
+
